---
import LogoWall from "../components/logoWall.astro";
import SocialIcon from "./icons/SocialIcon.astro";
import SkillsList from "./SkillsList.astro";
import Heading from "./ui/Heading.astro";
import ArrowIcon from "./icons/ArrowIcon.astro";
import Underline from "./common/Underline.astro";
import Expertise from "./Expertise.astro";
import PageContainer from "./common/PageContainer.astro";
import { PORTFOLIO_DATA } from "@/data/portfolio-data";
---

<section id="home" class="text-foreground mt-12 md:mt-0">
  <div class="flex flex-col gap-32 space-y-8 py-20 pb-14 md:py-44 lg:py-60">
    <PageContainer>
      <div class="space-y-4 text-left">
        <p
          class="text-md text-muted-foreground tracking-tight text-balance uppercase md:text-lg"
        >
          Hi, I'm Abdelmuttalib Ahmed, <span
            class="text-foreground font-medium"
          >
            Software Developer
          </span>
        </p>
        <div class="flex flex-col gap-8 md:gap-14">
          <Heading
            level={4}
            class="max-w-4xl leading-snug text-pretty md:leading-snug"
            as="h1"
          >
            <!-- Software Developer -->
            Transforming ideas into interactive and seamless digital experiences with
            cutting-edge <span class="text-foreground">software</span> development.
          </Heading>
          <p
            class="text-md text-foreground max-w-3xl tracking-tight md:text-3xl"
          >
            <!-- We help brands create clear visuals, strong websites, and consistent
          marketing. We turn bold ideas into intuitive experiences. We are a
          creative design studio. -->

            <!-- Transforming ideas into interactive and seamless digital experiences
          with cutting-edge <span class="text-foreground">software</span> development. -->
          </p>
        </div>
        <div class="flex flex-wrap justify-start gap-4">
          {
            PORTFOLIO_DATA.contact.email ? (
              <a
                href={`mailto:${PORTFOLIO_DATA.contact.email}`}
                class="group text-foreground bg-muted relative inline-flex items-center gap-2 p-2 text-lg tracking-tight hover:bg-neutral-100 sm:p-3 lg:p-4 dark:bg-neutral-900 dark:hover:bg-neutral-800"
              >
                <span> {PORTFOLIO_DATA.contact.email} </span>
              </a>
            ) : null
          }
          {
            PORTFOLIO_DATA.contact.tel ? (
              <a
                href={`tel:${PORTFOLIO_DATA.contact.tel}`}
                class="group text-foreground bg-muted relative inline-flex items-center gap-2 p-2 text-lg tracking-tight hover:bg-neutral-100 sm:p-3 lg:p-4 dark:bg-neutral-900 dark:hover:bg-neutral-800"
              >
                <span> {PORTFOLIO_DATA.contact.tel} </span>
              </a>
            ) : null
          }
        </div>
        <div class="mt-8 flex flex-wrap justify-start gap-8 sm:flex-row">
          {
            PORTFOLIO_DATA.contact.social.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noreferrer"
                class="group text-foreground relative inline-flex items-center gap-2 uppercase"
              >
                <span class="font-medium"> {social.name} </span>
                <ArrowIcon class="size-5" />
                <Underline />
              </a>
            ))
          }
          <!-- <a
            target="_blank"
            href="https://github.com/Abdelmuttalib"
            aria-label="GitHub"
            class="group text-foreground relative inline-flex items-center gap-2 uppercase"
          >
            <span class="font-medium"> Github </span>

            <ArrowIcon class="size-5" />
            <Underline />
          </a>
          <a
            target="_blank"
            href="https://linkedin.com/in/andresshernandez-eng"
            aria-label="LinkedIn"
            class="group text-foreground relative inline-flex items-center gap-2 uppercase"
          >
            <span class="font-medium"> LinkedIn </span>
            <ArrowIcon class="size-5" />
            <Underline />
          </a> -->
          <!-- <a
          target="_blank"
          href="https://mail.google.com/mail/?view=cm&fs=1&to=oscarandreshernandezpineda@gmail.com&su=Hey%20Oscar!"
          aria-label="Email"
          class="text-muted-foreground hover:text-white transition duration-300 ease-in-out border border-border p-3 rounded-xl bg-card"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a> -->
        </div>
      </div>
    </PageContainer>
  </div>
</section>
