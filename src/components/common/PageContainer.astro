---
import { cn } from "@/lib/utils";

type ContainerSize =
  | "default"
  | "full"
  | "xl"
  | "lg"
  | "base"
  | "md"
  | "sm"
  | "xs";

interface Props {
  size?: ContainerSize;
  class?: string;
}

const { size = "default", class: className } = Astro.props;

const sizeClasses = {
  default: "max-w-7xl",
  full: "max-w-full",
  xl: "max-w-screen-2xl",
  lg: "max-w-360",
  base: "max-w-6xl",
  md: "max-w-5xl",
  sm: "max-w-4xl",
  xs: "max-w-2xl",
};
---

<div
  class={cn(
    "relative mx-auto w-full flex-1 px-4 sm:px-6 lg:px-8",
    sizeClasses[size],
    className,
  )}
>
  <slot />
</div>
