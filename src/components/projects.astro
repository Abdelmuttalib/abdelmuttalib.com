  "#5ee7a5", // Lime
  "#5bc0ff", // Soft lavender

  "#4de1c1", // Mint turquoise
  "#ffb347", // Warm orange
  "#5bc0ff", // Sky blue
  "#ff7eb6", // Pink
  "#ffd95a", // Golden yellow
  "#9b8cff", // Periwinkle
  "#5ee7a5", // Fresh green
