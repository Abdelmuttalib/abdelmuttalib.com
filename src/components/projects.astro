---
import { Image } from "astro:assets";
import shadcnstyles from "../../public/images/projects/shadcn-styles-light.png";
import reactaria from "../../public/images/projects/react-aria-light.png";
import opulent from "../../public/images/projects/opulent-1.png";
import momentum from "../../public/images/projects/momentum-light.png";
import dashboardstarter from "../../public/images/projects/dashboard-starter-light.png";

import shadcnstylesDark from "../../public/images/projects/shadcn-styles-dark.png";
import reactariaDark from "../../public/images/projects/react-aria-dark.png";
import opulentDark from "../../public/images/projects/opulent-1.png";
import momentumDark from "../../public/images/projects/momentum-dark.png";
import dashboardstarterDark from "../../public/images/projects/dashboard-starter-dark.png";

export const projects = [
  {
    title: "shadcn ui styles",
    description: "Custom shadcn ui styles, components, palettes, and blocks.",
    technologies: [
      "React",
      "Nextjs",
      "Typescript",
      "TailwindCSS",
      "shadcn ui",
      "Stripe",
    ],
    image: shadcnstyles,
    imageDark: shadcnstylesDark,
    github: "https://github.com/Abdelmuttalib/shadcnui-marketplace",
    preview: "https://shadcnmarketplace.com",
    status: "Deployed",
  },
  {
    title: "Opulent",
    description:
      "Elegant e-commerce website powered by Stripe payments, providing seamless and secure transactions for customers.",
    technologies: [
      "React",
      "Nextjs",
      "Typescript",
      "TailwindCSS",
      "Railway",
      "Prisma",
      "Stripe",
    ],
    image: opulent,
    imageDark: opulentDark,
    github: "https://github.com/Abdelmuttalib/Opulent",
    preview: "https://opulent.vercel.app/",
    status: "Deployed",
  },

  {
    title: "React Aria",
    description:
      "a react component library for building accessible web apps. Built with Adobe Aria Components.",
    technologies: [
      "React",
      "Nextjs",
      "Typescript",
      "TailwindCSS",
      "shadcn ui",
      "Stripe",
    ],
    image: reactaria,
    imageDark: reactariaDark,
    github: "https://github.com/Abdelmuttalib/react-aria",
    preview: "https://www.react-aria.com/",
    status: "Deployed",
  },

  {
    title: "Momentum",
    description:
      "Issue tracking and project management web app, facilitating streamlined team collaboration and task management.",
    technologies: [
      "React",
      "Nextjs",
      "Typescript",
      "TailwindCSS",
      "Prisma",
      "tRPC",
      "NextAuth",
      "Supabase",
      "PostgreSQL",
    ],
    image: momentum,
    imageDark: momentumDark,
    github: "https://github.com/Abdelmuttalib/momentum",
    preview: "https://momentum-gamma.vercel.app/",
    status: "Deployed",
  },
  {
    title: "Dashboard Starter",
    description:
      "Dashboard starter template, featuring a clean and modern design with responsive layout and reusable components.",
    technologies: ["React", "Nextjs", "Typescript", "TailwindCSS"],
    image: dashboardstarter,
    imageDark: dashboardstarterDark,
    github: "https://github.com/Abdelmuttalib/nextjs-tailwindcss-dashboard",
    preview: "https://nextjs-tailwindcss-dashboard.vercel.app/",
    status: "Deployed",
  },
];
---

<section
  id="projects"
  class="text-foreground border-t border-[#ffffff10] py-12"
>
  <div class="mx-auto max-w-5xl">
    <h2 class="text-accent mb-2 text-lg">My work</h2>
    <h3 class="mb-8 text-4xl font-medium md:text-5xl">Projects</h3>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        projects.map((project) => (
          <div class="group">
            <a
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <div class="mb-4 overflow-hidden rounded-2xl shadow-lg transition-shadow duration-300 hover:shadow-xl">
                <Image
                  src={project.image}
                  alt={project.title}
                  class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105 md:h-72 dark:hidden"
                />
                <Image
                  src={project.imageDark}
                  alt={project.title}
                  class="hidden h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105 md:h-72 dark:block"
                />
              </div>
              <div class="flex items-center px-3">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold">{project.title}</h4>
                  <span class="text-muted-foreground py-1 text-sm">
                    {project.status}
                  </span>
                </div>
                <div class="ml-auto flex gap-2">
                  <a
                    target="_blank"
                    href={project.github}
                    aria-label="GitHub"
                    class="text-muted-foreground bg-card border-border hover:bg-card flex size-14 items-center justify-center rounded-xl border p-3 transition duration-300 ease-in-out hover:text-white"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                    </svg>
                  </a>
                  <a
                    target="_blank"
                    href={project.preview}
                    aria-label="Preview"
                    class="text-muted-foreground bg-card border-border hover:bg-card flex size-14 items-center justify-center rounded-xl border p-3 transition duration-300 ease-in-out hover:text-white"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
    <a
      target="_blank"
      href="https://github.com/Abdelmuttalib?tab=repositories"
      aria-label="GitHub"
      class="text-muted-foreground bg-card border-border hover:bg-card mt-9 flex w-full items-center justify-center gap-2 rounded-full border p-3 transition duration-300 ease-in-out hover:scale-105 hover:text-white"
    >
      <span class="text-md md:text-lg">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
