---
import Heading from "./ui/Heading.astro";
import BodyText from "./ui/BodyText.astro";
import ProjectsList from "./ProjectsList.astro";
import PageContainer from "./common/PageContainer.astro";
---

<section id="projects" class="text-foreground py-12 md:py-44 lg:py-60">
  <PageContainer>
    <div class="flex flex-col gap-16 md:gap-28">
      <div class="flex flex-col gap-6 md:flex-row md:justify-between">
        <Heading level={2} class="uppercase"> Projects </Heading>

        <BodyText variant="base/normal" class="leading-6 md:max-w-64">
          <!-- Case studies that walk through our approach and impact. -->
        </BodyText>
      </div>

      <ProjectsList />
    </div>
  </PageContainer>
</section>
