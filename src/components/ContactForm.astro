<div>
  <form
    id="contact-form"
    method="POST"
    action="https://api.web3forms.com/submit"
    class="flex flex-col gap-8 sm:gap-12"
  >
    <input
      type="hidden"
      name="access_key"
      value="c05f1410-f758-4721-b97d-e3eb74f06c1f"
    />

    <input type="hidden" name="subject" value="New Portfolio Contact" />

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-12">
      <div class="flex flex-col">
        <label
          for="name"
          class="text-muted-foreground sr-only text-xs uppercase"
          >Your name</label
        >
        <input
          id="name"
          type="text"
          name="name"
          placeholder="Name"
          required
          class="text-foreground border-muted-foreground/20 focus:border-foreground disabled:bg-muted/10 border-b py-3 text-sm focus:outline-none disabled:opacity-50 sm:text-base md:text-lg"
        />
      </div>
      <div class="flex flex-col">
        <label
          for="email"
          class="text-muted-foreground sr-only text-xs uppercase"
          >Your email</label
        >
        <input
          id="email"
          type="email"
          name="email"
          placeholder="Email"
          required
          class="text-foreground border-muted-foreground/20 focus:border-foreground disabled:bg-muted/10 border-b py-3 text-sm focus:outline-none disabled:opacity-50 sm:text-base md:text-lg"
        />
      </div>
    </div>

    <div class="flex flex-col">
      <label
        for="service"
        class="text-muted-foreground sr-only text-xs uppercase"
        >What can I help you with?</label
      >
      <select
        id="service"
        name="service"
        required
        class="text-foreground border-muted-foreground/20 focus:border-foreground disabled:bg-muted/10 border-b py-3 text-sm focus:outline-none disabled:opacity-50 sm:text-base md:text-lg"
      >
        <option value="New Website">New Website</option>
        <option value="Website Redesign">Website Redesign</option>
        <option value="E-commerce">E-commerce</option>
        <option value="Web Application">Web Application</option>
        <option value="Wordpress Development">Wordpress Development</option>
        <option value="Shopify Development">Shopify Development</option>
        <option value="SEO & Search Visibility">SEO & Search Visibility</option>
        <option value="Data Analytics">Data Analytics</option>
        <option value="Website Maintenance / Improvements">
          Website Maintenance / Improvements
        </option>
        <option value="Other">Other</option>

        <!--
            <option value="" disabled selected> How can I help you? </option>
            <option value="New Website">New Website</option>
            <option value="Website Redesign">Website Redesign</option>
            <option value="E-commerce Website">E-commerce Website</option>
            <option value="Web Application">Web Application</option>
            <option value="Website Fixes / Improvements">
              Website Fixes / Improvements
            </option>
            <option value="Other">Other</option> -->
      </select>
    </div>

    <div class="flex flex-col">
      <label
        for="message"
        class="text-muted-foreground sr-only text-xs uppercase">message</label
      >
      <textarea
        id="message"
        name="message"
        placeholder="Message"
        rows="6"
        required
        class="text-foreground border-muted-foreground/20 focus:border-foreground disabled:bg-muted/10 resize-none border-b py-3 text-sm focus:outline-none disabled:opacity-40 sm:text-base md:text-lg"
        value="fdsfsdf"></textarea>
    </div>

    <!-- Honeypot -->
    <input
      type="checkbox"
      name="botcheck"
      style="display:none"
      tabindex="-1"
      autocomplete="off"
    />

    <div class="mt-8">
      <button
        id="contact-submit"
        type="submit"
        class="text-background bg-foreground hover rounded-lg px-8 py-2.5 text-base font-medium uppercase transition-opacity hover:opacity-100 disabled:opacity-50"
        ><span id="contact-submit-text"> Send </span>
      </button>
    </div>
  </form>

  <!-- Status -->
  <!-- <div
    id="form-message"
    role="status"
    aria-live="polite"
    class="text-foreground mt-4 hidden items-center justify-center text-lg"
  >
  </div> -->

  <div
    id="form-message"
    role="status"
    aria-live="polite"
    class="text-foreground mt-4 hidden w-fit items-center justify-center border-b py-2 text-lg"
  >
  </div>
</div>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-message");
  const button = document.getElementById("contact-submit");
  const buttonText = document.getElementById("contact-submit-text");

  const nameInput = document.getElementById("name");
  const emailInput = document.getElementById("email");
  const serviceInput = document.getElementById("service");
  const messageInput = document.getElementById("message");

  const setSubmitting = (submitting) => {
    button.disabled = submitting;

    // controls.forEach((control) => {
    //   control.disabled = submitting;
    // });

    nameInput.disabled = submitting;
    emailInput.disabled = submitting;
    serviceInput.disabled = submitting;
    messageInput.disabled = submitting;

    buttonText.textContent = submitting ? "Sending..." : "Submit";
  };

  const showStatus = (message, type = "success") => {
    status.textContent = message;

    status.classList.remove("hidden", "border-emerald-500", "border-red-500");

    if (type === "success") {
      status.classList.add("border-emerald-500");
    } else {
      status.classList.add("border-red-500");
    }
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form) {
      return;
    }

    const formData = new FormData(form);

    // Prevent duplicate submissions.
    if (button.disabled) return;

    setSubmitting(true);

    // Hide previous status.
    status.classList.add("hidden");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: {
          Accept: "application/json",
        },
      });

      const result = await response.json();

      console.log("Web3Forms:", result);

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Something went wrong.");
      }

      // Success
      showStatus("Thank you! Your message has been sent.", "success");

      form.reset();
    } catch (error) {
      console.error("Contact form error:", error);

      // IMPORTANT:
      // Don't reset the form on failure.
      // The user keeps everything they typed.
      showStatus("Something went wrong. Please try again.", "error");
    } finally {
      // ALWAYS restore the form after the request finishes,
      // whether it succeeded or failed.
      setSubmitting(false);
    }
  });

  // form.addEventListener("submit", async (e) => {
  //   e.preventDefault();
  //   const formData = new FormData(form);

  //   try {
  //     const response = await fetch(form.action, {
  //       method: "POST",
  //       body: formData,
  //       headers: { Accept: "application/json" },
  //     });
  //     if (response.ok) {
  //       form.reset();
  //       form.style.display = "none";
  //       formMessage.classList.remove("hidden");
  //     } else {
  //       const data = await response.json();
  //       console.error("Error response:", data);
  //       alert("There was a problem sending your message.");
  //     }
  //   } catch (error) {
  //     console.error("Error:", error);
  //     alert("There was a problem sending your message.");
  //   }
  // });
</script>
