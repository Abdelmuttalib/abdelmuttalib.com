---
import { getCollection } from "astro:content";

const posts = await getCollection("blogs");

const recentPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="blog" class="py-16">
  <div class="mx-auto flex max-w-5xl flex-col gap-8">
    <!-- Section Header -->
    <div class="flex flex-col gap-2">
      <p class="text-accent text-sm tracking-widest uppercase">Blog</p>

      <div
        class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <h2 class="text-foreground text-3xl font-semibold">
            Thoughts &amp; Notes
          </h2>

          <p class="text-muted-foreground mt-2 max-w-2xl">
            Things I've learned, built, and experimented with.
          </p>
        </div>

        <a
          href="/blog"
          class="text-foreground hover:text-accent text-sm transition-colors"
        >
          View all posts →
        </a>
      </div>
    </div>

    <!-- Posts -->
    <div class="flex flex-col gap-4">
      {
        recentPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group bg-card border-border block rounded-lg border p-5 transition-all duration-200 hover:border-[var(--sec)] hover:bg-[#181818]"
          >
            <article class="flex flex-col gap-4">
              {/* <!-- Meta --> */}
              <div class="flex flex-wrap items-center gap-3 text-xs tracking-wider uppercase">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-muted-foreground"
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>

                <span class="text-muted-foreground">•</span>

                <span class="text-accent">
                  {post.data.tags?.[0] ?? "Article"}
                </span>
              </div>

              {/* <!-- Content --> */}
              <div class="flex items-start justify-between gap-4">
                <div class="flex flex-col gap-2">
                  <h3 class="text-foreground group-hover:text-accent text-xl font-medium transition-colors">
                    {post.data.title}
                  </h3>

                  <p class="text-muted-foreground max-w-3xl text-sm leading-6">
                    {post.data.excerpt}
                  </p>
                </div>

                <span
                  aria-hidden="true"
                  class="group-hover:text-accent text-muted-foreground hidden text-xl transition-all duration-200 group-hover:translate-x-1 sm:block"
                >
                  →
                </span>
              </div>

              {/* <!-- Tags --> */}
              {/* {
                post.data.tags?.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )
              } */}
            </article>
          </a>
        ))
      }
    </div>

    <!-- Mobile / Bottom CTA -->
    <div class="flex justify-start sm:justify-end">
      <a
        href="/blog"
        class="text-foreground hover:text-accent border-border rounded-lg border px-4 py-2 text-sm transition-all hover:border-[var(--sec)]"
      >
        View all posts →
      </a>
    </div>
  </div>
</section>
