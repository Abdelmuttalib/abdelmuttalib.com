---
import { getCollection } from "astro:content";
import Heading from "./ui/Heading.astro";
import { Image } from "astro:assets";
import BodyText from "./ui/BodyText.astro";
import ArrowIcon from "./icons/ArrowIcon.astro";
import PageContainer from "./common/PageContainer.astro";

const blogs = await getCollection("blogs");

const recentBlogs = blogs
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="blog" class="text-foreground py-12 md:py-44 lg:py-60">
  <PageContainer>
    <div class="flex flex-col gap-16 md:gap-28">
      <!-- <h2 class="text-accent mb-2 text-lg">My work</h2> -->
      <!-- <h3
      class="mb-8 leading-[.94em] tracking-[-.055em]"
      style="font-size: clamp(3.25rem,7.4vw,7.4rem);"
    >
      Selected motion.
    </h3> -->

      <div class="flex flex-col gap-6 md:flex-row md:justify-between">
        <!-- <Heading level={1} class="uppercase"> Blog </Heading> -->
        <Heading level={2} class="uppercase"> Blogs </Heading>

        <BodyText variant="base/normal" class="leading-6 md:max-w-64">
          Case studies that walk through our approach and impact.
        </BodyText>
      </div>
      <div class="mx-auto flex max-w-360 flex-col gap-8">
        <div
          class="mx-auto grid max-w-360 grid-cols-1 gap-4 gap-y-32 sm:grid-cols-1 md:grid-cols-2"
        >
          {
            blogs.map((blog) => (
              <a href={`/blog/${blog.id}`} class="group bg-card block">
                <article class="flex flex-col gap-6">
                  <div>
                    {blog.data.cover && (
                      <figure class="relative aspect-video overflow-hidden rounded-xl">
                        <Image
                          src={blog.data.cover as ImageMetadata}
                          alt={blog.data.coverAlt ?? ""}
                          widths={[640, 960, 1200, 1600, 2000]}
                          sizes="(min-width: 1200px) 1200px, 100vw"
                          loading="eager"
                          decoding="async"
                          class="w-full"
                        />
                        {/* {blog.data.creditName && (
                      <figcaption>
                        {blog.data.creditUrl ? (
                          <a
                            href={blog.data.creditUrl}
                            target="_blank"
                            rel="noreferrer"
                            class="underline underline-offset-2"
                          >
                            {blog.data.creditName}
                          </a>
                        ) : (
                          blog.data.creditName
                        )}
                      </figcaption>
                    )} */}
                      </figure>
                    )}
                  </div>
                  <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-3 text-xs tracking-wider uppercase">
                      <time
                        datetime={blog.data.date.toISOString()}
                        class="text-muted-foreground"
                      >
                        {blog.data.date.toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </time>

                      {/* <span class="text-muted-foreground">•</span>

                    <span class="text-muted-foreground">
                      {blog.data.tags?.[0] ?? "Article"}
                    </span> */}
                    </div>

                    <div class="flex items-start justify-between gap-4">
                      <div class="flex flex-col gap-6">
                        {/* <h2 class="group-hover:text-accent text-xl tracking-tight transition-colors">
                      {blog.data.title}
                    </h2> */}

                        <h4 class="max-w-lg text-2xl leading-8 tracking-tight">
                          {blog.data.title}
                        </h4>

                        {/* <p class="text-muted-foreground line-clamp-2 max-w-3xl leading-6">
                        {blog.data.excerpt}
                      </p> */}
                      </div>
                    </div>

                    {/* {blog.data.tags?.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {blog.data.tags.map((tag) => (
                      <span class="text-muted-foreground border-border rounded-md border px-2 py-1 text-xs">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )} */}
                  </div>
                </article>
              </a>
            ))
          }
        </div>
        <!-- Blogs -->
        <!-- <div class="flex flex-col gap-4">
      {
        recentBlogs.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group bg-card border-border hover:border-accent block rounded-lg border p-5 transition-all duration-200 hover:bg-[#181818]"
          >
            <article class="flex flex-col gap-4">
              <div class="flex flex-wrap items-center gap-3 text-xs tracking-wider uppercase">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-muted-foreground"
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
