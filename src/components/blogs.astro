                  →
                </span>
              </div>
            </article>
          </a>
        ))
      }
    </div> -->

        <!-- <div class="flex justify-start sm:justify-end">
      <a
        href="/blog"
        class="text-foreground hover:text-accent border-border hover:border-accent rounded-lg border px-4 py-2 text-sm transition-all"
      >
        View all posts →
      </a>
    </div> -->
        <div class="mt-10 flex md:justify-end">
          <a
            href="/blog"
            class="bg-foreground border-foreground text-background inline-flex items-center gap-2 rounded-full border px-5 py-3 text-sm font-medium tracking-tight uppercase"
          >
            View all blogs
            <ArrowIcon class="size-5" />
          </a>
        </div>
      </div>
    </div>
  </PageContainer>
</section>
