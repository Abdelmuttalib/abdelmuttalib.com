---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const recentPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="blog" class="py-16">
  <div class="mx-auto flex max-w-5xl flex-col gap-8">
    <!-- Section Header -->
    <div class="flex flex-col gap-2">
      <p class="text-sm uppercase tracking-widest text-[var(--sec)]">Blog</p>

      <div
        class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <h2 class="text-3xl font-semibold text-[var(--white)]">
            Thoughts &amp; Notes
          </h2>

          <p class="mt-2 max-w-2xl text-[var(--white-icon)]">
            Things I've learned, built, and experimented with.
          </p>
        </div>

        <a
          href="/blog"
          class="text-sm text-[var(--white)] transition-colors hover:text-[var(--sec)]"
        >
          View all posts →
        </a>
      </div>
    </div>

    <!-- Posts -->
    <div class="flex flex-col gap-4">
      {
        recentPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block rounded-lg border border-[var(--white-icon-tr)] bg-[#1414149c] p-5 transition-all duration-200 hover:border-[var(--sec)] hover:bg-[#181818]"
          >
            <article class="flex flex-col gap-4">
              {/* <!-- Meta --> */}
              <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wider">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-[var(--white-icon)]"
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>

                <span class="text-[var(--white-icon)]">•</span>

                <span class="text-[var(--sec)]">
                  {post.data.tags?.[0] ?? "Article"}
                </span>
              </div>

              {/* <!-- Content --> */}
              <div class="flex items-start justify-between gap-4">
                <div class="flex flex-col gap-2">
                  <h3 class="text-xl font-medium text-[var(--white)] transition-colors group-hover:text-[var(--sec)]">
                    {post.data.title}
                  </h3>

                  <p class="max-w-3xl text-sm leading-6 text-[var(--white-icon)]">
                    {post.data.description}
                  </p>
                </div>

                <span
                  aria-hidden="true"
                  class="hidden text-xl text-[var(--white-icon)] transition-all duration-200 group-hover:translate-x-1 group-hover:text-[var(--sec)] sm:block"
                >
                  →
                </span>
              </div>

              {/* <!-- Tags --> */}
              {/* {
                post.data.tags?.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-md border border-[var(--white-icon-tr)] px-2 py-1 text-xs text-[var(--white-icon)]">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )
              } */}
            </article>
          </a>
        ))
      }
    </div>

    <!-- Mobile / Bottom CTA -->
    <div class="flex justify-start sm:justify-end">
      <a
        href="/blog"
        class="rounded-lg border border-[var(--white-icon-tr)] px-4 py-2 text-sm text-[var(--white)] transition-all hover:border-[var(--sec)] hover:text-[var(--sec)]"
      >
        View all posts →
      </a>
    </div>
  </div>
</section>
