---
import { siteConfig } from "@/config/site";
import ContactForm from "./ContactForm.astro";
import Heading from "./ui/Heading.astro";

const socials = siteConfig.socials.map((item) => ({
  ...item,
  // icon:
  //   socialIconByLabel[item.label as keyof typeof socialIconByLabel] ??
  //   "link-45deg",
}));
---

<section id="contact" class="w-full py-12">
  <div class="mx-auto grid max-w-400 grid-cols-1 gap-8 md:grid-cols-2">
    <div class="flex flex-col gap-10">
      <Heading level={5} class="text-pretty" as="h2"> Contact </Heading>

      <div>
        <div class="flex flex-col gap-8">
          <div class="flex flex-wrap gap-8">
            <a
              href="mailto:abdelmuttalib1@gmail.com"
              class="text-foreground decoration-muted-foreground/30 hover:text-foreground hover:decoration-foreground text-lg underline underline-offset-8 transition duration-300 ease-in-out"
            >
              abdelmuttalib1@gmail.com
              <!-- &copy; {currentYear}. All rights reserved. -->
            </a>
            <a
              href="tel:+639455102063"
              class="text-foreground decoration-muted-foreground/30 hover:text-foreground hover:decoration-foreground text-lg underline underline-offset-8 transition duration-300 ease-in-out"
            >
              +63 945 510 2063
              <!-- &copy; {currentYear}. All rights reserved. -->
            </a>
          </div>
          <div>
            <nav class="flex gap-8">
              {
                socials.map((item) => (
                  <a
                    href={item.href}
                    class="group text-foreground relative block w-fit text-base uppercase"
                  >
                    {item.label}
                    <span class="ease-brand bg-foreground absolute -bottom-1 left-0 h-px w-0 transition-all duration-300 group-hover:w-full rtl:right-0 rtl:left-auto" />
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-8">
      <div class="">
        <p class="text-3xl tracking-tight">Send me a message.</p>
      </div>

      <div>
        <ContactForm />
      </div>
    </div>
  </div>
</section>
