---
import LocalIcon from "@/components/LocalIcon.astro";
import { navigation, footerNavigation, siteConfig } from "@/config/site";
import Heading from "./ui/Heading.astro";

const socialIconByLabel = {
  Instagram: "instagram",
  TikTok: "tiktok",
  YouTube: "youtube",
  RSS: "rss",
  LinkedIn: "linkedin",
  GitHub: "github",
  Twitter: "twitter",
} as const;

const socials = siteConfig.socials.map((item) => ({
  ...item,
  icon:
    socialIconByLabel[item.label as keyof typeof socialIconByLabel] ??
    "link-45deg",
}));
const currentYear = new Date().getFullYear();
---

<footer
  class="outer border-border mt-(--space-section) border-t bg-white dark:bg-black"
>
  <div
    class="mx-auto grid max-w-6xl gap-10 py-24 text-center md:grid-cols-1 md:items-center md:gap-8 md:text-left"
  >
    <div class="flex flex-col gap-9">
      <Heading level={2}>
        Let's work <span class="italic"> together</span>.
      </Heading>

      <div class="flex flex-wrap gap-6">
        <a
          href="mailto:abdelmuttalib1@gmail.com"
          class="text-muted-foreground decoration-muted-foreground/50 hover:text-foreground hover:decoration-foreground underline underline-offset-8 transition duration-300 ease-in-out"
        >
          abdelmuttalib1@gmail.com
          <!-- &copy; {currentYear}. All rights reserved. -->
        </a>

        <a
          href="tel:+639455102063"
          class="text-muted-foreground decoration-muted-foreground/50 hover:text-foreground hover:decoration-foreground underline underline-offset-8 transition duration-300 ease-in-out"
        >
          +63 945 510 2063

          <!-- &copy; {currentYear}. All rights reserved. -->
        </a>
      </div>
    </div>
  </div>

  <div
    class="inner border-border/60 grid gap-10 border-t py-16 text-center md:grid-cols-2 md:gap-8 md:text-left"
  >
    <div class="col-span-1 text-left">
      <a href="/" class="text-xl">{siteConfig.name}</a>
      <p class="text-muted-foreground mt-2">Available for new projects.</p>
      <!-- <p class="text-muted-foreground mt-2 text-xs">
        &copy; {currentYear}. All rights reserved.
      </p> -->
    </div>

    <div class="col-span-1 grid grid-cols-2 gap-6 lg:grid-cols-2 lg:gap-20">
      <div class="w-full">
        <p class="text-muted-foreground mb-5 text-left text-sm">
          <!-- {item.section} -->
          Navigation
        </p>

        <nav aria-label="Footer navigation" class="">
          <ul class="flex flex-col flex-wrap gap-x-4 gap-y-4">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group text-foreground relative block w-fit text-base"
                  >
                    {item.label}
                    <span class="ease-brand bg-foreground absolute -bottom-1 left-0 h-px w-0 transition-all duration-300 group-hover:w-full rtl:right-0 rtl:left-auto" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="w-full">
        <p class="text-muted-foreground mb-5 text-left text-sm">
          <!-- {item.section} -->
          Social
        </p>

        <nav class="space-y-4">
          {
            socials.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noreferrer"
                class="group text-foreground relative block w-fit text-base"
              >
                {item.label}
                <span class="ms-1.5">↗</span>
                <span class="ease-brand bg-foreground absolute -bottom-1 left-0 h-px w-0 transition-all duration-300 group-hover:w-full rtl:right-0 rtl:left-auto" />
              </a>
            ))
          }
        </nav>
      </div>
      <!-- <p class="text-muted-foreground text-xs md:text-right">
        Built with <a
          href="https://astro.build/"
          rel="noreferrer"
          class="link-quiet underline underline-offset-2">Astro</a
        >
      </p> -->
    </div>
  </div>

  <div
    class="inner border-border/60 grid gap-10 border-t py-8 pb-12 text-center md:grid-cols-1 md:items-center md:justify-center md:gap-8 md:text-left"
  >
    <div class="text-center">
      <p class="text-muted-foreground text-sm">
        &copy; {currentYear}{" "}
        {siteConfig.name}. All rights reserved.
      </p>
      <!-- <p>© 2026 Maren Voss · Photographer, Lisbon, Portugal</p> -->
    </div>
  </div>
</footer>

<style>
  .social-btn {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    border-radius: var(--radius-full);
    transition:
      border-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .social-btn:hover,
  .social-btn:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
    transform: translateY(-2px);
  }

  .footer-dot {
    width: 2px;
    height: 2px;
    background: var(--border-strong);
    border-radius: 50%;
  }
</style>
