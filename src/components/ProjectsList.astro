                      "bg-opacity-30 m-2 rounded-xl bg-transparent px-2 py-2 backdrop-blur-md transition-all duration-700 ease-out group-hover:mb-6 group-hover:from-(--project-color)/80 group-hover:via-(--project-color)/40 dark:from-(--project-color)/60 dark:via-(--project-color)/20",
