const servicesColors = ["#583d96", "#2d6d74", "#78434f", "#4d537f", "#6f6730"];

const skills = {
  "Web Development": [
    "Single Page Applications (SPAs)",
    "Landing pages and business websites",
  ],
  "Mobile Development": [
    "Mobile-friendly web apps",
    "React Native mobile apps",
  ],
  "UI/UX Design & Prototyping": [
    "UI design with Figma & Canva",
    "UX research & improvements",
    "Prototyping for websites & mobile apps",
  ],
};
---

<div class="flex flex-col gap-10 pt-3 text-left md:pt-9">
  <!-- <h3 class="text-foreground text-3xl font-semibold md:mb-6 md:text-4xl">
    What I do?
  </h3> -->
  <Heading level={5} class="text-pretty" as="h3"> What I do? </Heading>
  <ul class="mt-4 grid grid-cols-1 gap-6 text-lg md:grid-cols-2 lg:grid-cols-3">
    {
      Object.entries(skills).map(([category, items], index) => {
        let colorIndex: number = servicesColors.length - 1;

        if (index < servicesColors.length) {
          colorIndex = index;
        }

        if (index >= servicesColors.length) {
          const randomIndexInColorArray = Math.floor(
            Math.random() * servicesColors.length - 1,
          );
          colorIndex = randomIndexInColorArray;
        }

        const color = servicesColors[colorIndex];

        return (
          <li class="w-full">
            <div
              style={`--project-color: ${color}`}
              class:list={[
                "h-full w-full cursor-pointer overflow-hidden rounded-2xl p-8 text-left transition-all",
                "rounded-2xl",
                "from-foreground via-foreground bg-linear-[145deg] to-(--project-color)",
                "text-white",
                "bg-[linear-gradient(145deg,var(--black)_28%,var(--project-color)_68%,color-mix(in_srgb,var(--project-color)_70%,white)_100%)]",

                // "from-background bg-linear-to-br via-(--project-color)/50 to-(--project-color)",
                "backdrop-blur-lg transition-all duration-700 ease-out",
                "group-hover:mb-6 group-hover:via-(--project-color)/70",
              ]}
            >
              {/* <div
                class="bg-[linear-gradient(145deg,#151510_28%,color-mix(in_srgb,var(--project-color)_50%,#151510)_68%,var(--project-color)_100%)]"
                style={`--project-color: ${color}`}
              /> */}
              <div class="flex h-full flex-col justify-between gap-24">
                <div class="tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </div>
                <div class="flex flex-col gap-4">
                  <div class="flex items-center gap-3">
                    {/* {CategoryIcons[category]} */}
                    <div class="flex grow items-center justify-between gap-2">
                      <div class="max-w-52 min-w-0 overflow-hidden">
                        <Heading
                          level={6}
                          as="span"
                          class="max-w-10 text-white"
                        >
                          {category}
                        </Heading>
                      </div>
                    </div>
                  </div>

                  <div class="">
                    <ul class="space-y-2 text-white/60">
                      {items.map((item, index) => (
                        <div class="flex items-center">
                          <span class="pl-1">•</span>
                          <li class="pl-3">{item}</li>
                        </div>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="">
                  <button class="inline-flex items-center gap-2 rounded-3xl border border-white px-4 py-2 text-xs font-medium text-white uppercase transition-opacity hover:opacity-100 disabled:opacity-50">
                    <span> Explore </span>
                    <span>↗</span>
                  </button>
                </div>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>
