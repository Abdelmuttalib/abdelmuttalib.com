---
import type { FontSize, FontTone, FontWeight } from "@/lib/types";
import { cn } from "@/lib/utils";

type TypographyVariant = `${FontSize}/${FontWeight}`;

interface Props {
  as?: keyof HTMLElementTagNameMap;
  variant?: TypographyVariant;
  tone?: FontTone;
  class?: string;
}

const {
  as = "p",
  variant = "base/normal",
  tone = "foreground",
  class: className,
} = Astro.props as Props;

const fontSizeMap: Record<FontSize, string> = {
  xs: "text-xs",
  sm: "text-sm sm:text-sm",
  base: "text-sm sm:text-base",
  md: "text-sm sm:text-md",
  lg: "text-md md:text-lg",
  xl: "text-lg md:text-xl",
  "2xl": "text-lg sm:text-xl md:text-2xl",
  "3xl": "text-xl sm:text-2xl md:text-3xl",
  "4xl": "text-2xl sm:text-3xl md:text-4xl",
  "5xl": "text-3xl sm:text-4xl md:text-5xl",
  "6xl": "text-4xl sm:text-5xl md:text-6xl",
  "7xl": "text-5xl sm:text-6xl md:text-7xl",
  "8xl": "text-6xl sm:text-7xl md:text-8xl",
};

const fontWeightMap: Record<FontWeight, string> = {
  light: "font-light",
  normal: "font-normal",
  medium: "font-medium",
  semibold: "font-semibold",
  bold: "font-bold",
  extrabold: "font-extrabold",
};

const fontToneMap: Record<FontTone, string> = {
  foreground: "text-foreground",
  "foreground-muted": "text-muted-foreground",
  body: "text-foreground-body",
  "body-muted": "text-foreground-body-muted",
  heading: "text-foreground",
  section: "text-foreground",
  caption: "text-foreground-caption",
  list: "text-foreground-body",
  subtle: "text-foreground-subtle",
};

const [size, weight] = variant.split("/") as [FontSize, FontWeight];

const classes = cn(
  "text-balance",
  fontSizeMap[size] ?? fontSizeMap.md,
  fontWeightMap[weight] ?? fontWeightMap.normal,
  fontToneMap[tone],
  className,
);

const Tag = as;
---

<Tag class={classes}>
  <slot />
</Tag>
