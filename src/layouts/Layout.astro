---
import SiteHeader from "@/components/SiteHeader.astro";
import "../styles/global.css";
import SiteFooter from "@/components/SiteFooter.astro";
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.socialImage,
  type = "website",
  noindex = false,
  prevUrl,
  nextUrl,
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const absoluteImage = new URL(image, siteConfig.siteUrl).toString();
const pageTitle =
  title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
  publisher: {
    "@type": "Organization",
    name: siteConfig.authorName,
  },
};
const schema = structuredData ?? defaultStructuredData;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href="/fonts/inter-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="canonical" href={canonical} />

    <!-- {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />} -->

    <!-- <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={new URL("/rss.xml", siteConfig.siteUrl).toString()} /> -->

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />

    <!-- Structured Data (JSON-LD) -->
    <!-- <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Abdelmuttalib Ahmed",
        "alternateName": "Abdelmuttalib Ahmed",
        "url": "https://abdelmuttalib.vercel.app",
        "image": "https://abdelmuttalib.vercel.app/og-image.png",
        "sameAs": [
          "https://github.com/Abdelmuttalib",
          "https://www.linkedin.com/in/abdelmuttalib-ahmed-81919b160"
        ],
        "jobTitle": "Software Developer",
        "description": "Software Developer building interactive and seamless digital experiences."
      }
    </script> -->

    <script is:inline>
      /*
       * Runs before first paint so the stored reading mode is applied without a
       * flash. Falls back to the system preference until the reader picks a side.
       */
      (() => {
        const storageKey = "theme";
        const root = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        let storedTheme;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const updateToggles = (theme) => {
          const isDark = theme === "dark";
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-checked", String(isDark));
            button.setAttribute(
              "aria-label",
              isDark ? "Switch to light mode" : "Switch to dark mode",
            );
          });
        };

        const setTheme = (theme, persist = false) => {
          root.dataset.theme = theme;
          root.classList.remove("dark", "light");
          root.classList.add(theme);
          if (persist) {
            storedTheme = theme;
            try {
              localStorage.setItem(storageKey, theme);
            } catch {}
          }
          updateToggles(theme);
        };

        const preferredTheme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : systemDark.matches
              ? "dark"
              : "light";

        setTheme(preferredTheme);

        systemDark.addEventListener("change", (event) => {
          if (storedTheme === "light" || storedTheme === "dark") return;
          setTheme(event.matches ? "dark" : "light");
        });

        window.addEventListener("DOMContentLoaded", () => {
          updateToggles(root.dataset.theme || preferredTheme);
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              setTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
            });
          });
        });
      })();
    </script>
  </head>
  <body
    class="text-foreground bg-background flex min-h-svh flex-col antialiased"
  >
    <!-- DEV -->
    <div
      class="bg-brand-accent fixed right-2 bottom-2 z-9999 flex items-end gap-2 border p-1 text-sm font-medium"
    >
      <div class="size-fit">
        <div class="block sm:hidden">xs</div>
        <div class="hidden sm:block md:hidden">sm</div>
        <div class="hidden md:block lg:hidden">md</div>
        <div class="hidden lg:block xl:hidden">lg</div>
        <div class="hidden xl:block 2xl:hidden">xl</div>
        <div class="hidden 2xl:block">2xl</div>
      </div>
    </div>

    <!-- DEV END -->
    <a
      href="#main-content"
      class="focus:bg-brand-black focus:text-brand-bg sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:px-4 focus:py-2 focus:text-sm"
      >Skip to content
    </a>
    <SiteHeader />
    <div class="grow">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>

