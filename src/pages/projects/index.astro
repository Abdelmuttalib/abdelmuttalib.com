---
import PageContainer from "@/components/common/PageContainer.astro";
import ProjectsList from "@/components/ProjectsList.astro";
import BodyText from "@/components/ui/BodyText.astro";
import Heading from "@/components/ui/Heading.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Projects">
  <main id="main-content" class="grid grid-cols-1 gap-28 py-32">
    <PageContainer>
      <header class="flex w-full flex-col gap-4">
        <div class="flex flex-col gap-6 md:flex-row md:justify-between">
          <Heading level={1} class="uppercase"> Projects </Heading>

          <!-- <BodyText variant="base/normal" class="leading-6 md:max-w-xs">
          Real projects that show how we think, work, and solve problems
          effectively together.
        </BodyText> -->
        </div>
      </header>

      <ProjectsList />
    </PageContainer>
  </main>
</Layout>
