---
import PageContainer from "@/components/common/PageContainer.astro";
import Contact from "@/components/contact.astro";
import Experience from "@/components/Experience.astro";
import Expertise from "@/components/Expertise.astro";
import BodyText from "@/components/ui/BodyText.astro";
import Heading from "@/components/ui/Heading.astro";
import Typography from "@/components/ui/Typography.astro";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="About" description="Send me a message.">
  <main id="main-content" class="grid grid-cols-1 py-32">
    <PageContainer>
      <header class="flex w-full flex-col gap-4">
        <div class="flex flex-col gap-6 md:flex-row md:justify-between">
          <Heading level={1} class="uppercase"> About </Heading>

          <!-- <BodyText variant="base/normal" class="leading-6 md:max-w-xs">
          Tell me about your project.
        </BodyText> -->
        </div>
      </header>
      <div class="grid grid-cols-1 gap-28 py-32">
        <div class="grid w-full gap-6">
          <div class="flex flex-wrap justify-between gap-12">
            <div class="flex flex-col gap-6">
              <Heading
                level={6}
                class="max-w-4xl leading-tight md:leading-tight"
              >
                Building digital experiences with cutting-edge software
                development.
              </Heading>
            </div>
            <div>
              <Image
                src="https://avatars.githubusercontent.com/u/54845047?v=4"
                alt="Me"
                width={460 / 4}
                height={460 / 4}
                class="rounded-2xl object-cover grayscale"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>

          <div class="flex max-w-2xl flex-col gap-6">
            <Typography as="p" variant="2xl/normal" class="tracking-tight">
              I’ve built and maintained complex platforms—from e-commerce and
              booking systems to 3D model rendering apps
            </Typography>

            <p class="text-muted-foreground text-xl">
              With a strong eye for design, I translate UI/UX principles into
              responsive, accessible interfaces and implement modern best
              practices including CI/CD pipelines, testing (Jest, Cypress), and
              performance optimization.
            </p>
          </div>
        </div>
      </div>
    </PageContainer>

    <Expertise />

    <Experience />

    <Contact />
  </main>
</Layout>
