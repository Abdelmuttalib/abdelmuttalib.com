---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Blog">
  <main id="blog" class="mx-auto max-w-5xl px-6 py-16 text-[var(--white)]">
    <!-- Back -->
    <a
      href="/#blog"
      class="text-sm text-[var(--white-icon)] transition-colors hover:text-[var(--sec)]"
    >
      ← Back to home
    </a>

    <!-- Header -->
    <header class="mt-8 flex flex-col gap-4">
      <p class="text-sm uppercase tracking-widest text-[var(--sec)]">Blog</p>

      <div class="flex flex-col gap-2">
        <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
          Thoughts &amp; Notes
        </h1>

        <p class="max-w-2xl text-[var(--white-icon)]">
          Things I've learned, built, and experimented with.
        </p>
      </div>
    </header>

    <!-- Posts -->
    <div class="mt-10 flex flex-col gap-4">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block rounded-lg border border-[var(--white-icon-tr)] bg-[#1414149c] p-5 transition-all duration-200 hover:border-[var(--sec)] hover:bg-[#181818]"
          >
            <article class="flex flex-col gap-4">
              <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wider">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-[var(--white-icon)]"
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>

                <span class="text-[var(--white-icon)]">•</span>

                <span class="text-[var(--sec)]">
                  {post.data.tags?.[0] ?? "Article"}
                </span>
              </div>

              <div class="flex items-start justify-between gap-4">
                <div class="flex flex-col gap-2">
                  <h2 class="text-xl font-medium transition-colors group-hover:text-[var(--sec)]">
                    {post.data.title}
                  </h2>

                  <p class="max-w-3xl text-sm leading-6 text-[var(--white-icon)]">
                    {post.data.description}
                  </p>
                </div>

                <span
                  aria-hidden="true"
                  class="hidden text-xl text-[var(--white-icon)] transition-all duration-200 group-hover:translate-x-1 group-hover:text-[var(--sec)] sm:block"
                >
                  →
                </span>
              </div>

              {post.data.tags?.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-md border border-[var(--white-icon-tr)] px-2 py-1 text-xs text-[var(--white-icon)]">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </article>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
