---
import Heading from "@/components/ui/Heading.astro";
import BodyText from "@/components/ui/BodyText.astro";
import Layout from "@/layouts/Layout.astro";
import { visibleBlogs } from "@/lib/blogs";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import PageContainer from "@/components/common/PageContainer.astro";

const blogs = visibleBlogs(await getCollection("blogs"));
---

<Layout title="Projects">
  <main id="main-content">
    <PageContainer>
      <div class="grid grid-cols-1 gap-28 py-32">
        <!-- Header -->
        <header class="flex w-full flex-col gap-4">
          <div class="flex flex-col gap-6 md:flex-row md:justify-between">
            <Heading level={1} class="uppercase"> Blog </Heading>

            <!-- <BodyText variant="base/normal" class="leading-6 md:max-w-xs">
          Real projects that show how we think, work, and solve problems
          effectively together.
        </BodyText> -->
          </div>
        </header>

        <section
          class="border-border grid w-full grid-cols-1 gap-4 gap-y-32 border-t py-10 sm:gap-8 lg:grid-cols-2"
        >
          {
            blogs.map((blog) => (
              <a href={`/blog/${blog.id}`} class="group block">
                <article class="flex flex-col gap-4">
                  <div>
                    {blog.data.cover && (
                      <figure class="relative aspect-video overflow-hidden rounded-xl">
                        <Image
                          src={blog.data.cover as ImageMetadata}
                          alt={blog.data.coverAlt ?? ""}
                          widths={[640, 960, 1200, 1600, 2000]}
                          sizes="(min-width: 1200px) 1200px, 100vw"
                          loading="eager"
                          decoding="async"
                          class="h-full w-full object-cover"
                        />
                        {/* {blog.data.creditName && (
                      <figcaption>
                        {blog.data.creditUrl ? (
                          <a
                            href={blog.data.creditUrl}
                            target="_blank"
                            rel="noreferrer"
                            class="underline underline-offset-2"
                          >
                            {blog.data.creditName}
                          </a>
                        ) : (
                          blog.data.creditName
                        )}
                      </figcaption>
                    )} */}
                      </figure>
                    )}
                  </div>
                  <div class="flex flex-col gap-2">
                    <div class="flex flex-wrap items-center gap-3 text-sm font-medium uppercase tabular-nums">
                      <time
                        datetime={blog.data.date.toISOString()}
                        class="text-muted-foreground"
                      >
                        {blog.data.date.toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </time>

                      {/* <span class="text-muted-foreground">•</span>

                  <span class="text-muted-foreground">
                    {blog.data.tags?.[0] ?? "Article"}
                  </span> */}
                    </div>

                    <div class="flex items-start justify-between gap-4">
                      <div class="flex flex-col gap-6">
                        {/* <h2 class="group-hover:text-accent text-xl tracking-tight transition-colors">
                      {blog.data.title}
                    </h2> */}

                        {/* <Heading level={6} as="h2">
                      {blog.data.title}
                    </Heading> */}

                        <h2 class="group-hover:text-accent font- max-w-sm text-2xl tracking-[-.03em] transition-colors">
                          {blog.data.title}
                          {/* Editorial layout science for the web */}
                        </h2>

                        {/* <p class="text-muted-foreground line-clamp-2 max-w-3xl leading-6">
                      {blog.data.excerpt}
                    </p> */}
                      </div>
                    </div>

                    {/* {blog.data.tags?.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {blog.data.tags.map((tag) => (
                      <span class="text-muted-foreground border-border rounded-md border px-2 py-1 text-xs">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )} */}
                  </div>
                </article>
              </a>
            ))
          }
        </section>
      </div>
    </PageContainer>
  </main>
</Layout>
