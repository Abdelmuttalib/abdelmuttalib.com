---
import Heading from "@/components/ui/Heading.astro";
import BodyText from "@/components/ui/BodyText.astro";
import Layout from "@/layouts/Layout.astro";
import { visibleBlogs } from "@/lib/blogs";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const blogs = visibleBlogs(await getCollection("blogs"));
---

<Layout title="Blog">
  <main id="main-content" class="outer grid grid-cols-1 gap-28 py-32">
    <!-- Header -->
    <header class="mx-auto flex w-full max-w-6xl flex-col gap-4">
      <!-- <p class="text-accent text-sm tracking-widest uppercase">Blog</p> -->

      <div class="flex flex-col gap-6">
        <Heading level={1}> Blog </Heading>

        <BodyText variant="base/normal">
          A few recent collaborations across identity, web, product, and motion.
        </BodyText>

        <!-- <p class="text-muted-foreground max-w-2xl">
          Things I've learned, built, and experimented with.
        </p> -->
      </div>
    </header>

    <!-- Blogs -->
    <div
      class="mx-auto grid max-w-6xl grid-cols-1 gap-10 gap-y-32 sm:grid-cols-1"
    >
      {
        blogs.map((blog) => (
          <a href={`/blog/${blog.id}`} class="group bg-card block">
            <article class="flex flex-col gap-6">
              <div>
                {blog.data.cover && (
                  <figure class="relative aspect-video overflow-hidden rounded-2xl">
                    <Image
                      src={blog.data.cover.src}
                      alt={blog.data.cover.alt}
                      widths={[640, 960, 1200, 1600, 2000]}
                      sizes="(min-width: 1200px) 1200px, 100vw"
                      loading="eager"
                      decoding="async"
                      class="w-full"
                    />
                    {/* {blog.data.cover.creditName && (
                      <figcaption>
                        {blog.data.cover.creditUrl ? (
                          <a
                            href={blog.data.cover.creditUrl}
                            target="_blank"
                            rel="noreferrer"
                            class="underline underline-offset-2"
                          >
                            {blog.data.cover.creditName}
                          </a>
                        ) : (
                          blog.data.cover.creditName
                        )}
                      </figcaption>
                    )} */}
                  </figure>
                )}
              </div>
              <div class="flex flex-col gap-4">
                <div class="flex flex-wrap items-center gap-3 text-xs tracking-wider uppercase">
                  <time
                    datetime={blog.data.date.toISOString()}
                    class="text-muted-foreground"
                  >
                    {blog.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>

                  <span class="text-muted-foreground">•</span>

                  <span class="text-muted-foreground">
                    {blog.data.tags?.[0] ?? "Article"}
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4">
                  <div class="flex flex-col gap-6">
                    {/* <h2 class="group-hover:text-accent text-xl tracking-tight transition-colors">
                      {blog.data.title}
                    </h2> */}

                    <Heading level={5} as="h2">
                      {blog.data.title}
                    </Heading>

                    <p class="text-muted-foreground line-clamp-2 max-w-3xl leading-6">
                      {blog.data.excerpt}
                    </p>
                  </div>
                </div>

                {/* {blog.data.tags?.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {blog.data.tags.map((tag) => (
                      <span class="text-muted-foreground border-border rounded-md border px-2 py-1 text-xs">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )} */}
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
