---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <!-- <title>{post.data.title} | Abdelmuttalib</title> -->

  <main class="mx-auto max-w-5xl px-6 py-16">
    <!-- Back -->
    <a
      href="/blog"
      class="text-sm text-[var(--white-icon)] transition-colors hover:text-[var(--sec)]"
    >
      ← Back to blog
    </a>

    <!-- Header -->
    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <time
          datetime={post.data.date.toISOString()}
          class="text-[var(--white-icon)]"
        >
          {
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>

        <!-- {
            post.data.tags.length > 0 && (
              <>
                <span class="text-[var(--white-icon)]">•</span>

                <span class="text-[var(--sec)]">{post.data.tags[0]}</span>
              </>
            )
          } -->
      </div>

      <h1
        class="mt-4 text-4xl font-bold tracking-tight text-[var(--white)] md:text-5xl"
      >
        {post.data.title}
      </h1>

      <p class="mt-4 max-w-3xl text-lg leading-8 text-[var(--white-icon)]">
        {post.data.description}
      </p>
    </header>

    <!-- Article -->
    <article class="prose prose-invert mt-12 max-w-none text-[var(--white)]">
      <Content />
    </article>

    <!-- Footer -->
    <footer class="mt-16 border-t border-[var(--white-icon-tr)] pt-6">
      <a
        href="/blog"
        class="text-sm text-[var(--white)] transition-colors hover:text-[var(--sec)]"
      >
        ← Back to blog
      </a>
    </footer>
  </main>
</Layout>
