        </div> -->

          <!-- {
          data.updatedDate && (
            <p class="meta mt-5">
              <span>
                Updated{" "}
                <time datetime={data.updatedDate.toISOString()}>
                  {formatDate(data.updatedDate)}
                </time>
              </span>
            </p>
          )
        } -->

          <!-- <div
          class="border-border mt-8 flex flex-wrap items-center gap-2 border-t pt-6"
          role="group"
          aria-labelledby="share-heading"
        >
          <h2 id="share-heading" class="eyebrow mr-1">Share</h2>
          {
            shareLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="share-btn"
                aria-label={`Share ${data.title} on ${link.label}`}
              >
                <LocalIcon name={link.icon} className="h-4 w-4" />
              </a>
            ))
          }
          <button
            type="button"
            class="share-btn"
            data-copy-link
            data-copy-url={articleUrl}
            aria-label={`Copy link to ${data.title}`}
          >
            <LocalIcon name="link-45deg" className="h-4 w-4" />
          </button>
          <p
            class="text-muted-foreground ml-1 text-xs"
            aria-live="polite"
            data-copy-status
          >
          </p>
        </div> -->
        </header>

        {
          data.cover && (
            <figure class="article-image">
              <Image
                src={data.cover as ImageMetadata}
                alt={data.coverAlt ?? ""}
                widths={[640, 960, 1200, 1600, 2000]}
                sizes="(min-width: 1200px) 1200px, 100vw"
                loading="eager"
                decoding="async"
                class="w-full"
              />
              {data.creditName && (
