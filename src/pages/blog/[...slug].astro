---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import Callout from "@/components/mdx/Callout.astro";
import CodeGroup from "@/components/mdx/CodeGroup.astro";
import CodeGroupItem from "@/components/mdx/CodeGroupItem.astro";

import { Image } from "astro:assets";
import LocalIcon from "@/components/LocalIcon.astro";
import { siteConfig } from "@/config/site";
import {
  authorSlug,
  categoryHref,
  formatDate,
  getAdjacent,
  blogHref,
  blogSlug,
  readingLabel,
  visibleBlogs,
  type Blog,
} from "@/lib/blogs";
import Heading from "@/components/ui/Heading.astro";
import BodyText from "@/components/ui/BodyText.astro";
import Typography from "@/components/ui/Typography.astro";
import PageContainer from "@/components/common/PageContainer.astro";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs");

  return blogs.map((blog) => ({
    params: {
      slug: blog.id,
    },
    props: {
      blog,
      blogs: blogs,
    },
  }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);
const mdxComponents = { Callout, CodeGroup, CodeGroupItem };
const data = blog.data;
// const related = getRelated(allPosts, post);
// const { newer, older } = getAdjacent(allPosts, post);
// const authorHref = `/author/${authorSlug(data.author.name)}/`;
const articleUrl = new URL(blogHref(blog), siteConfig.siteUrl).toString();
const socialImage = data.cover
  ? new URL(data.cover.src, siteConfig.siteUrl).toString()
  : new URL(siteConfig.socialImage, siteConfig.siteUrl).toString();
const encodedUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(data.title);
const shareLinks: {
  label: string;
  icon: "twitter-x" | "facebook" | "linkedin";
  href: string;
}[] = [
  {
    label: "X",
    icon: "twitter-x",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    label: "Facebook",
    icon: "facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
  {
    label: "LinkedIn",
    icon: "linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt,
  image: socialImage,
  datePublished: data.date.toISOString(),
  dateModified: data.date.toISOString(),
  // dateModified: (data.updatedDate ?? data.date).toISOString(),
  author: { "@type": "Person", name: "Abdelmuttalib Ahmed" },
  publisher: { "@type": "Organization", name: siteConfig.authorName },
  mainEntityOfPage: articleUrl,
};
---

<Layout title={blog.data.title}>
  <!-- <title>{blog.data.title} | Abdelmuttalib</title> -->

