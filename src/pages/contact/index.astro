---
import Underline from "@/components/common/Underline.astro";
import ContactForm from "@/components/ContactForm.astro";
import SocialIcon from "@/components/icons/SocialIcon.astro";
import PhoneIcon from "@/components/icons/PhoneIcon.astro";
import MailIcon from "@/components/icons/MailIcon.astro";
import BodyText from "@/components/ui/BodyText.astro";
import Heading from "@/components/ui/Heading.astro";
import { siteConfig } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import ArrowIcon from "@/components/icons/ArrowIcon.astro";
import PageContainer from "@/components/common/PageContainer.astro";

const socials = siteConfig.socials.map((item) => ({
  ...item,
  // icon:
  //   socialIconByLabel[item.label as keyof typeof socialIconByLabel] ??
  //   "link-45deg",
}));
---

<Layout title="Contact" description="Send me a message.">
  <main id="main-content">
    <PageContainer>
      <div class="grid grid-cols-1 gap-28 py-32">
        <header class="flex w-full flex-col gap-4">
          <div class="flex flex-col gap-6 md:flex-row md:justify-between">
            <Heading level={1} class="uppercase"> Contact </Heading>

            <BodyText variant="base/normal" class="leading-6 md:max-w-xs">
              Tell me about your project.
            </BodyText>
          </div>
        </header>

        <div class="grid w-full grid-cols-1 gap-24 md:grid-cols-5 md:gap-44">
          <div class="md:col-span-2">
            <div class="flex flex-col gap-1">
              <div class="flex flex-col gap-1">
                <a
                  href="mailto:abdelmuttalib1@gmail.com"
                  class="group text-foreground border-border relative inline-flex items-center gap-2 bg-neutral-50 p-4 py-4 text-lg tracking-tight uppercase hover:bg-neutral-100 dark:bg-neutral-900 dark:hover:bg-neutral-800"
                >
                  <MailIcon class="size-5" />
                  abdelmuttalib1@gmail.com
                  <!-- &copy; {currentYear}. All rights reserved. -->
                </a>
                <a
                  href="tel:+639455102063"
                  class="group text-foreground border-border relative inline-flex items-center gap-2 bg-neutral-50 p-4 py-4 text-lg tracking-tight uppercase hover:bg-neutral-100 dark:bg-neutral-900 dark:hover:bg-neutral-800"
                >
                  <PhoneIcon class="size-5" />
                  +63 945 510 2063
                  <!-- &copy; {currentYear}. All rights reserved. -->
                </a>
              </div>
              <div class="w-full">
                <nav class="flex w-full flex-col gap-1">
                  {
                    socials.map((item) => (
                      <a
                        href={item.href}
                        class="group text-foreground relative inline-flex w-full items-center gap-2 bg-neutral-50 p-4 text-lg uppercase hover:bg-neutral-100 dark:bg-neutral-900 dark:hover:bg-neutral-800"
                        target="_blank"
                      >
                        <SocialIcon
                          platform={item.iconId as any}
                          class="size-5"
                        />
                        <span>{item.label}</span>
                        <ArrowIcon class="text-muted-foreground/40 group-hover:text-foreground ms-auto size-5" />
                      </a>
                    ))
                  }
                </nav>
              </div>
            </div>
          </div>
          <div class="md:col-span-3">
            <div>
              <!-- <h2 class="text-accent mb-2 text-lg">Contact</h2>
        <h3 class="text-foreground mb-6 text-4xl font-medium md:text-5xl">
          Contact Me
        </h3> -->
              <!-- <Heading level={5}> Send me a message </Heading> -->
            </div>

            <div>
              <ContactForm />
            </div>
          </div>
        </div>
      </div>
    </PageContainer>
  </main>
</Layout>
